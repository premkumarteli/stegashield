              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stego/detect": {
      "post": {
        "tags": [
          "Steganography"
        ],
        "summary": "Detect Stego",
        "description": "Run Chi-Square attack and RS Analysis statistical steganalysis on candidate image.",
        "operationId": "detect_stego_api_v1_stego_detect_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_detect_stego_api_v1_stego_detect_post"
