      "post": {
        "tags": [
          "Attack Lab"
        ],
        "summary": "Start Attack Lab Experiment",
        "description": "Initiate Attack Lab matrix sweep across embedding methods, ratios, and detectors.\n\nEnforces mutex locking: returns HTTP 409 Conflict if another experiment is currently running.",
        "operationId": "start_attack_lab_experiment_api_v1_attack_lab_run_post",
