      "post": {
        "tags": [
          "Steganography"
        ],
        "summary": "Embed Steganography",
        "description": "Embed payload (text or file) into cover image using authenticated encryption & LSB embedding.",
        "operationId": "embed_steganography_api_v1_stego_embed_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_embed_steganography_api_v1_stego_embed_post"
