              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stego/analyze": {
      "post": {
        "tags": [
          "Steganography"
        ],
        "summary": "Analyze Comparison",
        "description": "Compare cover and stego images, generating MSE, PSNR, SSIM, heatmap, bitplane, and PoV histogram.",
        "operationId": "analyze_comparison_api_v1_stego_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_comparison_api_v1_stego_analyze_post"
