    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check Health",
        "description": "Check API operational health and database connectivity.",
        "operationId": "check_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
