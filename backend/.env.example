# StegaShield Environment Variables Configuration
# Copy this file to .env and adjust as necessary for your environment.

# Database URL:
# Default SQLite: sqlite:///./stegashield.db
# MySQL 8.0: mysql+pymysql://stegashield:stegashield@localhost:3306/stegashield
DATABASE_URL=sqlite:///./stegashield.db

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:3000

# File Storage & Retention
FILE_TTL_MINUTES=30
MAX_UPLOAD_MB=10
MAX_PIXELS=16000000
STORAGE_DIR=data/files

# Secret key for sessions & security tokens
SECRET_KEY=stegashield-dev-secret-key-change-in-production
